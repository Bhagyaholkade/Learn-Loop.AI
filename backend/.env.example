# Server
PORT=3002
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=learnloop_ai

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Groq AI fallback
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter AI fallback (comma-separated models, tried in order)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=

# Email: "smtp" (e.g. Gmail) or "resend"
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=

# Dev only: log emails to console when sending fails
MAIL_DEV_FALLBACK=false

# Login session length (e.g. 15m, 12h, 1d)
JWT_EXPIRES_IN=1d
